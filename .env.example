# Dr. Murat Irmak Kliniği — ortam değişkenleri
# Bu dosya ŞABLONDUR; gerçek değer içermez ve repoya girer.
# Gerçek değerler Vercel proje ayarlarına ve yerelde .env / .env.local'e yazılır.

# --- Site ---
# Üretimde kendi domaini; boş bırakılırsa Vercel URL'i, o da yoksa
# www.drmuratirmak.com kullanılır. Canonical ve hreflang bunu kullanır.
NEXT_PUBLIC_SITE_URL=https://www.drmuratirmak.com

# --- SMTP (randevu ve iletişim formu) ---
# Eksikse form "mail_failed" döner ve kullanıcıya telefonla ulaşması söylenir.
# Sessizce "gönderildi" DENMEZ.
#
# Port: 465 → SSL (secure), 587 → STARTTLS.
# Parola için SMTP_PASS ya da SMTP_PASSWORD; ikisi de okunur.
# SMTP_FROM boşsa SMTP_USER kullanılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Form taleplerinin düşeceği klinik adresi ---
# Boşsa content/clinic.json → contact.appointmentEmail kullanılır.
MAIL_TO=dr_mirmak@hotmail.com

# --- Upstash Redis (form oran sınırı) ---
# Eksikse oran sınırı ATLANIR ve olay loglanır; form çalışmaya devam eder.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Yönetim paneli veritabanı ---
# PostgreSQL bağlantı adresi. Tanımlı değilse kamuya açık site content/
# dosyalarını okumaya devam eder; yönetim panelinin veri ekranları kapanır.
DATABASE_URL=

# --- Yönetim paneli kimlik doğrulama ---
# Oturum imzası ve saklanan SMTP parolasının şifrelenmesi için en az 32
# karakterlik, rastgele bir sır kullanın.
AUTH_SECRET=
# İlk db:seed çalıştırmasında oluşturulacak süper yöneticinin bilgileri.
# Parola en az 12 karakter olmalıdır; kullanıcı zaten varsa değiştirilmez.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Cloudflare R2 medya deposu ---
# Üretimde medya yüklemeleri için R2 erişim bilgileri. Eksikse geliştirme
# ortamında public/uploads altındaki yerel depolama kullanılır.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Yüklenen nesnelerin tarayıcıdan erişilen CDN veya R2 genel adresi.
R2_PUBLIC_BASE_URL=
