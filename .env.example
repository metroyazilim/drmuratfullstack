# Dr. Murat Irmak Kliniği — ortam değişkenleri
# Bu dosya ŞABLONDUR; gerçek değer içermez ve repoya girer.
# Gerçek değerler Vercel proje ayarlarına ve yerelde .env / .env.local'e yazılır.

# --- Site ---
# Üretimde kendi domaini; boş bırakılırsa Vercel URL'i, o da yoksa
# www.drmuratirmak.com kullanılır. Canonical ve hreflang bunu kullanır.
NEXT_PUBLIC_SITE_URL=https://www.drmuratirmak.com

# --- SMTP (randevu ve iletişim formu) ---
# Eksikse form "mail_failed" döner ve kullanıcıya telefonla ulaşması söylenir.
# Sessizce "gönderildi" DENMEZ.
#
# Port: 465 → SSL (secure), 587 → STARTTLS.
# Parola için SMTP_PASS ya da SMTP_PASSWORD; ikisi de okunur.
# SMTP_FROM boşsa SMTP_USER kullanılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Form taleplerinin düşeceği klinik adresi ---
# Boşsa content/clinic.json → contact.appointmentEmail kullanılır.
MAIL_TO=dr_mirmak@hotmail.com

# --- Upstash Redis (form oran sınırı) ---
# Eksikse oran sınırı ATLANIR ve olay loglanır; form çalışmaya devam eder.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
