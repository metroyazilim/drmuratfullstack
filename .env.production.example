# Dr. Murat Irmak Kliniği — üretim ortam değişkenleri (Dokploy → Environment
# sekmesi ya da docker-compose.yml yanındaki bir `.env` dosyası).
# Doldurulmuş hâli asla commit edilmez.
#
# REQUIRED işaretli değerler eksikse `docker compose up` baştan hata verir.

# --- Genel adres (REQUIRED) ----------------------------------------------
# Build sırasında istemci paketine gömülür; canonical, OG, sitemap ve JSON-LD
# bunu kullanır. Sonunda eğik çizgi olmamalı.
NEXT_PUBLIC_SITE_URL=https://www.drmuratirmak.com

# --- Veritabanı ------------------------------------------------------------
# POSTGRES_PASSWORD zorunludur. DATABASE_URL boş bırakılırsa compose onu
# aşağıdaki değerlerden üretir ve uygulamayı paketteki `db` servisine bağlar.
# Yönetilen bir Postgres kullanacaksan DATABASE_URL'i doğrudan yaz.
POSTGRES_USER=drmurat
POSTGRES_PASSWORD=
POSTGRES_DB=drmurat
# DATABASE_URL=postgresql://kullanici:parola@host:5432/drmurat?schema=public

# --- Yönetim paneli kimlik doğrulama (REQUIRED) ---------------------------
# En az 32 rastgele karakter: openssl rand -base64 32
# Oturum imzası ve panelde saklanan SMTP parolasının şifrelenmesi için kullanılır.
AUTH_SECRET=
# Yalnızca ilk `npm run db:seed` çalıştırmasında süper yöneticiyi oluşturur.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- SMTP (randevu ve iletişim formları) ----------------------------------
# Port 465 → SSL, 587 → STARTTLS. SMTP_FROM boşsa SMTP_USER kullanılır.
# Panelden de yönetilebilir (Ayarlar → E-posta); env değerleri yedektir.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Form taleplerinin düşeceği klinik adresi.
MAIL_TO=

# --- Upstash Redis (form oran sınırı) -------------------------------------
# Eksikse oran sınırı atlanır ve olay loglanır; formlar çalışmaya devam eder.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare R2 medya deposu -------------------------------------------
# Tanımsızsa yüklemeler konteyner içindeki `uploads` volume'una yazılır;
# birden fazla sunucuya ölçeklerken R2 şarttır.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
